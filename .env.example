# ==============================================================================
# BACKTRACE Platform Environment Configuration
# ==============================================================================

# General
PROJECT_NAME="BACKTRACE Learning Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True

# Backend Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="backtrace_user"
POSTGRES_PASSWORD="backtrace_password_secure"
POSTGRES_DB="backtrace_db"
DATABASE_URL="postgresql+asyncpg://backtrace_user:backtrace_password_secure@localhost:5432/backtrace_db"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# JWT Security Placeholder
SECRET_KEY="backtrace_super_secret_key_change_in_production_environment_32chars_min"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=115200

# CORS Origins (JSON list or comma separated)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","*"]

# Flutter Frontend Configuration
FLUTTER_API_BASE_URL="http://localhost:8000/api/v1"
